# Bare Auth0 hostname. No https:// and no trailing slash.
AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_CLIENT_ID=your-m2m-client-id
AUTH0_CLIENT_SECRET=your-m2m-client-secret

# Optional. Defaults to https://AUTH0_DOMAIN/api/v2/
# AUTH0_AUDIENCE=https://tenant.example.auth0.com/api/v2/

# Optional path to a JSON config file. Environment variables override it.
# AUTH0_CONFIG=./auth0-iga.config.json

# Test hook only. Rewrites Management API and token requests to this origin.
# The client secret is sent to that host. Do not point this at an untrusted server.
# AUTH0_BASE_URL=http://127.0.0.1:4010
