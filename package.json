  "keywords": [
    "auth0",
    "identity-governance",
    "iga",
    "access-review",
    "scim",
    "opentext",
    "ciam",
    "iam"
  ],
  "homepage": "https://github.com/PointBlueTechnology/auth0-iga-exporter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PointBlueTechnology/auth0-iga-exporter.git"
  },
